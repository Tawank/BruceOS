# Original ESP32 targets additionally support Classic Bluetooth HID host mode,
# which has no NimBLE equivalent (esp_hid only ships a NimBLE HID-over-GATT
# path, not Classic) -- so this is the one target that stays on Bluedroid.
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_HOST_ENABLED=y

# BTDM and the full Bruce runtime compete for the original ESP32's smaller
# IRAM. Keep Wi-Fi functional but place its optional hot paths in flash.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
