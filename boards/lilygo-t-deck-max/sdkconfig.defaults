# LilyGO T-Deck MAX (ESP32-S3, 16MB flash / 8MB quad PSRAM, GDEQ031T10 240x320
# e-paper, TCA8418 keyboard, CST3530 touch, XL9555 GPIO expander).
#
# Pins from LilyGO's TDeckMaxBoard.h (github.com/Xinyuan-LilyGO/T-Deck-MAX).
# The XL9555 expander and what hangs off it (power rails, PWRKEY, audio
# routing) are HAL devices in board.c. LoRa (SX1262), gyroscope and
# vibration motor have no driver yet; their power enables are left off.
CONFIG_IDF_TARGET="esp32s3"
# HAL devices from boards/lilygo-t-deck-max/board.c, whatever the build dir.
CONFIG_BRUCE_BOARD_ID="lilygo-t-deck-max"

# ---- Chip, flash and memory ----

# 16MB QIO flash.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# Quad PSRAM at 80 MHz; flash runs at the shared 80 MHz. That is the most
# this board supports: ESP-IDF knows how to run only listed flash chips above
# 80 MHz, and this module's 16MB Winbond chip is not one of them, while flash
# and PSRAM share one clock, so 120 MHz PSRAM would need 120 MHz flash.
# With PSRAM, sdkconfig.defaults.psram applies.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y

# ---- Board buses and power ----

# Board I2C: keyboard, touch, XL9555, ES8311, BQ27220; board.c's i2c0.
CONFIG_BRUCE_BOARD_I2C_ENABLED=y
CONFIG_BRUCE_BOARD_I2C_HAL=y


# Keep LoRa (CS 3, reset 4), SD (CS 48) and e-paper (CS 34) deselected on
# the shared SPI bus from boot, as LilyGO's firmware does.
CONFIG_BRUCE_BOARD_GPIO_HIGH_MASK=0x1000400000018

# ---- Display ----

# E-paper on SPI2_HOST, shared with the SD card. GPIO41 is the front light;
# LilyGO runs it at 50/255, full power can brown out the board.
CONFIG_BRUCE_DISPLAY_PANEL_UC8253=y
CONFIG_BRUCE_DISPLAY_WIDTH=240
CONFIG_BRUCE_DISPLAY_HEIGHT=320
CONFIG_BRUCE_DISPLAY_DEFAULT_ROTATION=0
CONFIG_BRUCE_DISPLAY_SPI_HOST=1
CONFIG_BRUCE_DISPLAY_PIN_MOSI=33
CONFIG_BRUCE_DISPLAY_PIN_SCK=36
CONFIG_BRUCE_DISPLAY_PIN_CS=34
CONFIG_BRUCE_DISPLAY_PIN_DC=35
CONFIG_BRUCE_DISPLAY_PIN_RST=9
CONFIG_BRUCE_DISPLAY_PIN_BUSY=37
CONFIG_BRUCE_DISPLAY_PIN_BL=41
CONFIG_BRUCE_DISPLAY_BACKLIGHT_MAX_LEVEL=64

# ---- Audio ----

# ES8311 codec. The ESP32 transmits on GPIO 40 (LilyGO's header calls it
# BOARD_ES8311_ASDOUT but passes it as the I2S data-out pin); 17 is the
# codec's microphone output.
CONFIG_BRUCE_AUDIO_BACKEND_I2S=y
CONFIG_BRUCE_AUDIO_I2S_BCLK_GPIO=39
CONFIG_BRUCE_AUDIO_I2S_DATA_GPIO=40
CONFIG_BRUCE_AUDIO_I2S_LRCLK_GPIO=18
CONFIG_BRUCE_AUDIO_I2S_MCLK_GPIO=38
CONFIG_BRUCE_AUDIO_ES8311_CODEC=y

# ---- Battery ----

# BQ27220 fuel gauge, board.c's "battery".
CONFIG_BRUCE_BATTERY_ENABLED=y
CONFIG_BRUCE_BATTERY_BACKEND_HAL=y

# ---- Storage ----

# SD card on the display's bus, board.c's spi2.
CONFIG_BRUCE_SD_ENABLED=y
CONFIG_BRUCE_SD_SPI_HOST=1
CONFIG_BRUCE_SD_PIN_MOSI=33
CONFIG_BRUCE_SD_PIN_MISO=47
CONFIG_BRUCE_SD_PIN_SCK=36
CONFIG_BRUCE_SD_PIN_CS=48

# ---- Input ----

# BOOT is Select.
CONFIG_BRUCE_BUTTON_SELECT_ENABLED=y
CONFIG_BRUCE_BUTTON_SELECT_GPIO=0
# CONFIG_BRUCE_BUTTON_A_ENABLED is not set
# CONFIG_BRUCE_BUTTON_B_ENABLED is not set
# CONFIG_BRUCE_BUTTON_C_ENABLED is not set

# TCA8418 keyboard, BlackBerry-style layout; the chip is board.c's "keyboard".
# CONFIG_BRUCE_KEYBOARD_ENABLED is not set
CONFIG_BRUCE_KEYBOARD_TCA8418_ENABLED=y
CONFIG_BRUCE_KEYBOARD_TCA8418_HAL=y
CONFIG_BRUCE_KEYBOARD_LAYOUT_TDECK=y

# CST3530 touch, board.c's "touch".
CONFIG_BRUCE_TOUCH_ENABLED=y
CONFIG_BRUCE_TOUCH_HAL=y

# ---- Radios ----

# GPS: u-blox MIA-M10Q on UART at 38400, powered through board.c's "gps".
CONFIG_BRUCE_GPS_ENABLED=y
CONFIG_BRUCE_GPS_UART_PORT=1
CONFIG_BRUCE_GPS_RX_GPIO=2
CONFIG_BRUCE_GPS_TX_GPIO=16
CONFIG_BRUCE_GPS_BAUD=38400

# A7682E modem on UART2 at 115200 (ESP RX 11 = modem TXD, TX 10 = modem
# RXD, as LilyGO's factory firmware opens it). Power, PWRKEY and audio
# routing are board.c's "modem". RI is GPIO 7
# and DTR GPIO 8 (BOARD_A7682E_RI/_DTR in LilyGO's TDeckMaxBoard.h).
CONFIG_BRUCE_CELLULAR_ENABLED=y
CONFIG_BRUCE_CELLULAR_UART_PORT=2
CONFIG_BRUCE_CELLULAR_RX_GPIO=11
CONFIG_BRUCE_CELLULAR_TX_GPIO=10
CONFIG_BRUCE_CELLULAR_BAUD=115200
# Mobile data needs more than 115200's ~11 KB/s (AT+IPR, up to 3686400).
CONFIG_BRUCE_CELLULAR_FAST_BAUD=921600
CONFIG_BRUCE_CELLULAR_RI_GPIO=7
CONFIG_BRUCE_CELLULAR_DTR_GPIO=8
# Mobile data: the modem selects lwIP PPP; IPv4 only and no VJ compression
# keep its code small. LCP echo notices a link that died silently.
# CONFIG_LWIP_PPP_ENABLE_IPV6 is not set
# CONFIG_LWIP_PPP_VJ_HEADER_COMPRESSION is not set
CONFIG_LWIP_ENABLE_LCP_ECHO=y
CONFIG_LWIP_LCP_ECHOINTERVAL=30

# No infrared or NRF24 on this board; left at the Kconfig defaults.
