CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_swap.csv"

# Target board has 8 MB flash; use the full size instead of the default 2 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
# Let esptool patch the image header to the detected chip size when flashing;
# runtime storage uses that detected size for its LittleFS partition.
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y

# Run the supported ESP32 targets at their maximum CPU frequency.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"
CONFIG_SPI_MASTER_ISR_IN_IRAM=y
CONFIG_SPI_SLAVE_ISR_IN_IRAM=y

# Production build settings: favor compact optimized code and retain warnings
# without compiling INFO/DEBUG logs into the firmware.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# Append the legacy GlobalSign Root CA (R1) to the default certificate
# bundle - see certs/globalsign_root_ca_r1.pem for why it's needed even
# though ESP-IDF's default bundle no longer ships it.
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="certs/globalsign_root_ca_r1.pem"

# Required by the Core process registry (src/core/process/process.c) for sampled
# per-process CPU accounting via uxTaskGetSystemState()/TaskStatus_t.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
# One Core process-context pointer is attached to each managed task.
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=2

# Trade IRAM/DIRAM space for scheduler and Wi-Fi throughput: FreeRTOS runs from
# flash cache instead of RAM, and the Wi-Fi library's hot paths (including RX)
# aren't pinned into IRAM either. Frees ~40K of RAM combined per ESP-IDF's own
# Kconfig help text; only revert if a real perf regression traces back here.
# CONFIG_FREERTOS_IN_IRAM is not set
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set

# Same trade for the heap allocator's own code (heap_caps_malloc/free etc.):
# place it in flash instead of IRAM. Safe here because no IRAM_ATTR ISR in
# this codebase (display.c's DMA-done callback, audio.c's I2S callback) ever
# calls a heap_caps_*/heap_trace_* function, which is the only case where this
# would be unsafe (cache disabled during a flash op while such an ISR runs).
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y

# espressif/elf_loader needs executable memory; memory protection in ESP-IDF
# v6 hides MALLOC_CAP_EXEC when enabled.  Disable it for the ELF loader slice.
CONFIG_ESP_SYSTEM_PMP_IDRAM_SPLIT=n
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE=n
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE_LOCK=n
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE_VIA_TEE=n

# Use Picolibc with newlib API compatibility (provides funopen, etc.).
# The espressif/elf_loader libc symbol table is disabled and the patched
# symbol file guards newlib-only symbols behind !__PICOLIBC__.
CONFIG_LIBC_PICOLIBC=y
CONFIG_LIBC_NEWLIB=n
CONFIG_LIBC_PICOLIBC_NEWLIB_COMPATIBILITY=y

# The default espressif/elf_loader symbol tables reference newlib symbols that
# are not exposed by the ESP-IDF v6 toolchain; the Bruce loader supplies its own
# allowlist via elf_set_symbol_resolver(), so disable the built-in tables.
CONFIG_ELF_LOADER_LIBC_SYMBOLS=n
CONFIG_ELF_LOADER_ESPIDF_SYMBOLS=n

# Every board-specific pin and peripheral choice (display, audio, battery,
# SD card, buttons, keyboard, IR, NRF24 - see src/Kconfig.projbuild) lives in
# boards/<board>/sdkconfig.defaults, one file per supported board, selected
# via `python tools/board.py <board> build` (see tools/board.py --list for
# the available board ids). Plain `idf.py build` with no board-specific
# defaults falls back to each option's own Kconfig default, which matches
# the M5 Cardputer's wiring.

# Host stack (Bluedroid vs NimBLE) is chosen per target below: esp32 keeps
# Bluedroid for Classic BT HID host support (bluetooth_hid.c); every BLE-only
# target (esp32s3 and onward) uses NimBLE instead, since Bluedroid's dual-mode
# footprint buys nothing there -- see sdkconfig.defaults.esp32/.esp32s3.
CONFIG_BT_ENABLED=y

# wolfSSL/wolfSSH (src/core/ssh/ssh.c): this ESP-IDF v6 mbedTLS port has no PSA
# crypto support, which permanently disables libssh2's ECDH/curve25519 KEX -
# wolfCrypt implements those with its own classic (non-PSA) APIs instead.
# Force pure-software crypto: wolfSSL's ESP32 hardware-acceleration port
# (AES/SHA/RSA peripheral glue) does not build against this ESP-IDF version's
# HAL (renamed peripheral-clock enums, removed memory-introspection APIs).
# Software crypto is the same tradeoff libssh2 already made via mbedTLS here.
CONFIG_ESP_WOLFSSL_ALT_HARDWARE_ACCELERATION=y
CONFIG_ESP_WOLFSSL_NO_ESP32_CRYPT=y
# Benign: wolfSSL's RSA-primitive stack-size warning for this main task size;
# not applicable once ESP32 HW crypto (incl. the RSA primitive) is disabled above.
CONFIG_ESP_WOLFSSL_NO_STACK_SIZE_BUILD_WARNING=y
# Bruce uses WAMR directly through wasm_export.h; its optional application
# manager is not needed and does not support ESP-IDF 6's POSIX surface.
CONFIG_WAMR_ENABLE_APP_FRAMEWORK=n
# WASM apps use only Bruce's explicit `bruce_sdk` imports. WAMR's WASI/libc
# and pthread layers would bypass Core stdio, storage, process identity, and
# permission enforcement.
CONFIG_WAMR_ENABLE_LIB_PTHREAD=n
CONFIG_WAMR_ENABLE_LIBC_BUILTIN=n
CONFIG_WAMR_ENABLE_LIBC_WASI=n
CONFIG_WAMR_ENABLE_AOT=n
CONFIG_WAMR_ENABLE_INTERP=y
CONFIG_WAMR_INTERP_CLASSIC=y
CONFIG_WAMR_INTERP_CLASSIC=y
CONFIG_WAMR_INTERP_LOADER_NORMAL=y
CONFIG_WAMR_ENABLE_MULTI_MODULE=n
CONFIG_WAMR_ENABLE_SHARED_MEMORY=n
