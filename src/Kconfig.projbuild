menu "Bruce hardware configuration"

    config BRUCE_QEMU_TEST_MODE
        bool "QEMU self-test mode"
        default n
        help
            Skip physical display and input initialization and expose the
            serial self-test protocol used by the QEMU pytest suite.

    choice BRUCE_BOARD
        prompt "Target board"
        default BRUCE_BOARD_M5_CARDPUTER
        help
            Select the M5Stack target board. This determines the LCD pinout,
            default screen orientation, backlight GPIO, and input hardware.

        config BRUCE_BOARD_M5_CARDPUTER
            bool "M5 Cardputer (ESP32-S3, ST7789V2 240x135)"

        config BRUCE_BOARD_M5_STICKC_PLUS2
            bool "M5 StickC Plus2 (ESP32-PICO-V3-02, ST7789V2 135x240)"
    endchoice

    config BRUCE_INPUT_POLL_PERIOD_MS
        int "Input poll period (ms)"
        default 20
        range 5 100
        help
            Period between physical input polls. Lower values reduce latency
            but use more CPU.

    config BRUCE_INPUT_DEBOUNCE_MS
        int "Input debounce time (ms)"
        default 30
        range 10 200
        help
            Minimum time between accepted state changes for a single button
            or key. Increase this if you see spurious repeated events.

    config BRUCE_INPUT_SCAN_SETTLE_US
        int "Keyboard scan settle time (us)"
        default 30
        range 10 200
        depends on BRUCE_BOARD_M5_CARDPUTER
        help
            Delay after changing the Cardputer keyboard scan outputs before
            reading the sense lines. Increase this if keys are missed.

    config BRUCE_INPUT_TASK_STACK
        int "Input task stack size (bytes)"
        default 8192
        range 2048 32768
        help
            Stack size for the bruce_input polling task. Increase this value if
            a stack overflow is reported for bruce_input.

    config BRUCE_IR_TX_GPIO
        int "Infrared transmit GPIO"
        default 44 if BRUCE_BOARD_M5_CARDPUTER
        default 19 if BRUCE_BOARD_M5_STICKC_PLUS2
        range 0 48
        help
            GPIO connected to the active-high infrared transmitter.

    config BRUCE_IR_RX_GPIO
        int "Infrared receive GPIO"
        default 1 if BRUCE_BOARD_M5_CARDPUTER
        default 33 if BRUCE_BOARD_M5_STICKC_PLUS2
        range 0 48
        help
             GPIO connected to the active-low infrared receiver output.

    config BRUCE_NRF24_SCK_GPIO
        int "NRF24 SPI clock GPIO"
        default 40 if BRUCE_BOARD_M5_CARDPUTER
        default 0 if BRUCE_BOARD_M5_STICKC_PLUS2
        range 0 48

    config BRUCE_NRF24_MISO_GPIO
        int "NRF24 SPI MISO GPIO"
        default 39 if BRUCE_BOARD_M5_CARDPUTER
        default 33 if BRUCE_BOARD_M5_STICKC_PLUS2
        range 0 48

    config BRUCE_NRF24_MOSI_GPIO
        int "NRF24 SPI MOSI GPIO"
        default 14 if BRUCE_BOARD_M5_CARDPUTER
        default 32 if BRUCE_BOARD_M5_STICKC_PLUS2
        range 0 48

    config BRUCE_NRF24_CS_GPIO
        int "NRF24 chip-select GPIO"
        default 1 if BRUCE_BOARD_M5_CARDPUTER
        default 26 if BRUCE_BOARD_M5_STICKC_PLUS2
        range 0 48

    config BRUCE_NRF24_CE_GPIO
        int "NRF24 chip-enable GPIO"
        default 2 if BRUCE_BOARD_M5_CARDPUTER
        default 25 if BRUCE_BOARD_M5_STICKC_PLUS2
        range 0 48
        help
            NRF24 defaults match the external SPI wiring used by Bruce legacy
            builds. The radio uses SPI3_HOST; IRQ is not required.

endmenu
